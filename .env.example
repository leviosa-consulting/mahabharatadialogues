# Template for local development. Copy to .env and fill in the blanks:
#   cp .env.example .env
#
# Then run: npm run dev   (port 3000, matching NEXT_PUBLIC_SITE_URL below)

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-side: Firestore + Storage)  -- REQUIRED
#
# Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> downloads a JSON file.
# Map the JSON fields:
#   project_id   -> FIREBASE_PROJECT_ID
#   client_email -> FIREBASE_CLIENT_EMAIL
#   private_key  -> FIREBASE_PRIVATE_KEY
#
# FIREBASE_PRIVATE_KEY must be double-quoted, on ONE line, with literal \n
# escapes -- exactly as it appears in the JSON. A raw multi-line PEM, or an
# unquoted value, fails with "Invalid PEM formatted message" at startup.
# src/firebase/firebaseAdmin.ts:25 expands the escapes.
#
# Without these three, src/firebase/firebaseAdmin.ts:13 throws at import time
# and EVERY route 500s -- the root layout depends on it via getPageSettings.
# FIREBASE_STORAGE_BUCKET is not guarded, but every image upload fails without it.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Firebase Web SDK (browser: Auth + Firestore + Storage)  -- REQUIRED
#
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These are public by design (they ship in the client bundle); they are not secrets.
# Without them getAuth() throws auth/invalid-api-key on every page.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Site origin  -- REQUIRED
#
# Server components fetch the app's own /api routes through this value. Several
# call sites have no fallback and will build "undefined/api/..." if it is unset,
# rendering empty events/products/about/testimonials pages.
# Locally this must be your dev origin, NOT the production domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# YouTube Data API v3  -- OPTIONAL
#
# Omit safely: src/lib/youtube.ts:29 warns and serves two hardcoded fallback
# videos rather than throwing.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
